<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TerrariaRuntimeTargetFramework)</TargetFramework>
    <AssemblyName>TerrariaRuntime.PatchEngine</AssemblyName>
    <RootNamespace>TerrariaRuntime.PatchEngine</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="MonoMod.Core" Version="1.3.6" ExcludeAssets="buildTransitive" />
    <PackageReference Include="MonoMod.Patcher" Version="$(MonoModPatcherVersion)" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="$(MonoModRuntimeDetourVersion)" ExcludeAssets="buildTransitive" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
  </ItemGroup>
</Project>
