<Project>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <TerrariaRuntimeTargetFramework>net11.0</TerrariaRuntimeTargetFramework>
    <DotNetPackageVersion>11.0.0</DotNetPackageVersion>
    <MonoModPatcherVersion>25.0.1</MonoModPatcherVersion>
    <MonoModCoreVersion>1.4.0-prerelease.3</MonoModCoreVersion>
    <MonoModRuntimeDetourVersion>25.4.0-prerelease.3</MonoModRuntimeDetourVersion>
    <Features>$(Features);runtime-async=on</Features>

    <!-- The older build-time MonoMod.Patcher package still targets up to net10. -->
    <MonoMod_ReallySkipCheckTargetRuntime>true</MonoMod_ReallySkipCheckTargetRuntime>
  </PropertyGroup>
</Project>
