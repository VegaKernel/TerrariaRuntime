<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>$(TerrariaRuntimeTargetFramework)</TargetFramework>
		<Version>1.1.4</Version>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<Nullable>enable</Nullable>
		<PackageReleaseNotes>Terraria 1.4.6.1 on .NET 11; allocation-free original-method fast path for unobserved generated hooks, preserving subscribed and public invoker semantics</PackageReleaseNotes>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Steamworks.NET" Version="2024.8.0" />
		<PackageReference Include="Mono.Cecil" Version="0.11.6" />
		<PackageReference Include="MonoMod.Core" Version="$(MonoModCoreVersion)" ExcludeAssets="buildTransitive" />
		<PackageReference Include="MonoMod.Patcher" Version="$(MonoModPatcherVersion)" />
		<PackageReference Include="MonoMod.RuntimeDetour" Version="$(MonoModRuntimeDetourVersion)" ExcludeAssets="buildTransitive" />
		<PackageReference Include="NuGet.Packaging" Version="7.9.0" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="$(DotNetPackageVersion)" />
		<PackageReference Include="System.Drawing.Common" Version="$(DotNetPackageVersion)" />
		<PackageReference Include="System.IO.Packaging" Version="$(DotNetPackageVersion)" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\TerrariaRuntime.PatchEngine\TerrariaRuntime.PatchEngine.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Patches Include="$(MSBuildProjectDirectory)\..\TerrariaRuntime.Scripts\Patches\**\*.cs" />
		<TopLevelScripts Include="$(MSBuildProjectDirectory)\..\TerrariaRuntime.Scripts\Mods\**\*.cs" />
		<Shims Include="$(MSBuildProjectDirectory)\..\TerrariaRuntime.Scripts\Shims\**\*.cs" />
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<MakeDir Directories="$(TargetDir)csharp\" />
		<RemoveDir Directories="$(TargetDir)csharp\plugins\" />
		<MakeDir Directories="$(TargetDir)csharp\plugins\" />
		<Copy SourceFiles="@(Patches)" DestinationFolder="$(TargetDir)csharp/plugins/patches/terraria/%(RecursiveDir)" />
		<Copy SourceFiles="@(TopLevelScripts)" DestinationFolder="$(TargetDir)csharp/plugins/mods/terraria/%(RecursiveDir)" />
		<Copy SourceFiles="@(Shims)" DestinationFolder="$(TargetDir)csharp/plugins/shims/terraria/%(RecursiveDir)" />
	</Target>
	<Target Name="CleanAll" AfterTargets="Clean">
		<RemoveDir Directories="$(OUTDIR)" />
	</Target>
</Project>
