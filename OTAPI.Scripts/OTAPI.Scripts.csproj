<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(OTAPITargetFramework)</TargetFramework>
		<PreserveCompilationReferences>true</PreserveCompilationReferences>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<Import Condition="Exists('..\OTAPI.Patcher\bin\Debug\$(TargetFramework)\AutoGenerated.target')" Project="..\OTAPI.Patcher\bin\Debug\$(TargetFramework)\AutoGenerated.target" />
	<Import Condition="Exists('..\OTAPI.Client.Launcher\bin\Debug\$(TargetFramework)\AutoGenerated.target')" Project="..\OTAPI.Client.Launcher\bin\Debug\$(TargetFramework)\AutoGenerated.target" />
	<ItemGroup>
		<Reference Include="OTAPI" Condition="Exists('../OTAPI.Patcher/bin/Debug/$(TargetFramework)/OTAPI.exe')">
			<HintPath>../OTAPI.Patcher/bin/Debug/$(TargetFramework)/OTAPI.exe</HintPath>
		</Reference>
		<Reference Include="OTAPI" Condition="Exists('../OTAPI.Patcher/bin/Debug/$(TargetFramework)/OTAPI.dll')">
			<HintPath>../OTAPI.Patcher/bin/Debug/$(TargetFramework)/OTAPI.dll</HintPath>
		</Reference>
		<Reference Include="OTAPI" Condition="Exists('../OTAPI.Patcher/bin/Debug/$(TargetFramework)/OTAPI.Runtime.dll')">
			<HintPath>../OTAPI.Patcher/bin/Debug/$(TargetFramework)/OTAPI.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Steamworks.NET" Condition="Exists('../OTAPI.Patcher/bin/Debug/$(TargetFramework)/EmbeddedResources/Steamworks.NET.dll')">
			<HintPath>../OTAPI.Patcher/bin/Debug/$(TargetFramework)/EmbeddedResources/Steamworks.NET.dll</HintPath>
		</Reference>
		<Reference Include="OTAPI" Condition="Exists('../OTAPI.Client.Launcher/bin/x64/Debug/$(TargetFramework)/client/OTAPI.exe')">
			<HintPath>../OTAPI.Client.Launcher/bin/x64/Debug/$(TargetFramework)/client/OTAPI.exe</HintPath>
		</Reference>
		<Reference Include="OTAPI" Condition="Exists('../OTAPI.Client.Launcher/bin/x64/Debug/$(TargetFramework)/client/OTAPI.Runtime.dll')">
			<HintPath>../OTAPI.Client.Launcher/bin/x64/Debug/$(TargetFramework)/client/OTAPI.Runtime.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\FNA\FNA.Core.csproj" />
		<PackageReference Include="Steamworks.NET" Version="2024.8.0" />
		<PackageReference Include="ModFramework" Version="1.1.15" />
		<PackageReference Include="MonoMod" Version="22.7.31.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Modules\OTAPI.Mods\Resources\" />
	</ItemGroup>
	<Target Name="CleanAll" AfterTargets="Clean">
		<RemoveDir Directories="$(OUTDIR)" />
	</Target>
</Project>
