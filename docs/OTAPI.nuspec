<?xml version="1.0"?>
<package>
  <metadata>
    <id>OTAPI</id>
    <title>Open Terraria API</title>
    <version>[INJECT_VERSION]</version>
    <authors>Open Terraria API contributors</authors>
    <owners>Open Terraria API contributors</owners>
    <license type="file">LICENSE</license>
    <projectUrl>https://github.com/SignatureBeef/Open-Terraria-API</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>
        OTAPI is a low-level Terraria integration layer that rewrites the official server assembly and exposes generated runtime hooks. This server-only distribution follows the upstream OTAPI patch model while carrying the .NET 11 baseline and narrowly scoped compatibility and performance work.

        The server package targets .NET 11. Runtime assemblies keep the OTAPI and OTAPI.Runtime assembly identities so existing low-level integrations do not require an assembly-name fork.
    </description>
    <summary>OTAPI [INJECT_VERSION] for Terraria 1.4.5.8[INJECT_GIT_HASH]</summary>
    <releaseNotes>
      OTAPI 4.0.0 - Terraria 1.4.5.8 server baseline on .NET 11.
    </releaseNotes>
    <copyright>Copyright 2016-[INJECT_YEAR]</copyright>
    <tags>Terraria,OTAPI</tags>
    [INJECT_DEPENDENCIES]
  </metadata>
</package>
