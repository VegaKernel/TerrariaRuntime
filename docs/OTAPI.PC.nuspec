<?xml version="1.0"?>
<package>
  <metadata>
    <id>VegaKernel.OTAPI</id>
    <title>VegaKernel Open Terraria API</title>
    <version>[INJECT_VERSION]</version>
    <authors>Open Terraria API contributors, VegaKernel</authors>
    <owners>VegaKernel</owners>
    <license type="file">COPYING.txt</license>
    <projectUrl>https://github.com/VegaKernel/Open-Terraria-API</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>
        VegaKernel's maintained Open Terraria API fork for the Vega server stack.

        OTAPI is a low-level Terraria integration layer that rewrites the official server assembly and exposes generated runtime hooks. This fork follows the upstream OTAPI patch model while carrying the .NET 11 server baseline and narrowly scoped VegaKernel compatibility and performance work.

        The server package targets .NET 11. Runtime assemblies keep the OTAPI and OTAPI.Runtime assembly identities so existing low-level integrations do not require an assembly-name fork.
    </description>
    <summary>VegaKernel OTAPI [INJECT_VERSION] for Terraria 1.4.5.8[INJECT_GIT_HASH]</summary>
    <releaseNotes>
      Terraria 1.4.5.8 - VegaKernel .NET 11 server baseline derived from upstream OTAPI 3.3.14.
    </releaseNotes>
    <copyright>Copyright 2016-[INJECT_YEAR]</copyright>
    <tags>Terraria,OTAPI,VegaKernel</tags>
    [INJECT_DEPENDENCIES]
  </metadata>
</package>
